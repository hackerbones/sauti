{
  "name": "Sauti — Stream & Download Music",
  "short_name": "Sauti",
  "description": "Stream full-length music for free and download tracks for offline listening.",
  "start_url": "/sauti/",
  "scope": "/sauti/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "/sauti/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/sauti/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/sauti/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/sauti/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false
}
